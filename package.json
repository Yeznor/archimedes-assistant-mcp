{
  "name": "archimedes-assistant-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for searching Archimedes Market assets and bounties.",
  "type": "module",
  "bin": {
    "archimedes-assistant-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run check && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "start:http": "node dist/http.js",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "vitest run tests",
    "test:http": "node scripts/http-acceptance.mjs",
    "test:live": "npm run build && node scripts/live-acceptance.mjs"
  },
  "keywords": [
    "archimedes-market",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "copilot"
  ],
  "author": "Yeznor",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "@hono/node-server": "^2.0.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
